{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Terminal API + App",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "Frontend dev (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
